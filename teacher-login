<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>دخول المعلم - مدارس الفلاح الأهلية</title>
<link href="https://fonts.googleapis.com/css2?family=Calibri:wght@400;700&display=swap" rel="stylesheet">

<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>

<style>
body{font-family:Calibri;background:#f4f4f4;margin:0;padding:20px}
.container{max-width:450px;margin:60px auto;background:#fff;padding:25px;border-radius:12px;box-shadow:0 0 10px rgba(0,0,0,0.15)}
h1{text-align:center;color:#1976d2;margin-bottom:5px}
h2{text-align:center;color:#555;margin-top:0;font-size:18px}
label{display:block;margin-top:10px;font-weight:bold}
input{padding:9px;font-size:15px;width:100%;border-radius:8px;border:1px solid #999;box-sizing:border-box;margin-top:5px}
button{padding:10px 15px;border:none;border-radius:8px;background:#1976d2;color:white;font-size:16px;font-weight:bold;cursor:pointer;margin-top:15px;width:100%}
button:hover{opacity:0.9}
.error{color:#d32f2f;margin-top:10px;text-align:center;font-size:14px}
.info{text-align:center;font-size:13px;color:#555;margin-top:15px}
.link-btn{background:#757575;margin-top:8px}
</style>
</head>
<body>

<div class="container">
  <h1>مدارس الفلاح الأهلية</h1>
  <h2>دخول المعلم</h2>

  <label>البريد الإلكتروني للمعلم</label>
  <input id="email_input" type="email" placeholder="example@school.com">

  <label>كلمة المرور</label>
  <input id="password_input" type="password" placeholder="••••••••">

  <button onclick="loginTeacher()">دخول</button>

  <div id="error_box" class="error"></div>

  <div class="info">
    بيانات الدخول يتم إنشاؤها من قبل المشرف عبر Firestore (مجموعة teachers).
  </div>

  <button class="link-btn" onclick="location='index.html'">الصفحة الرئيسية</button>
</div>

<script>
var firebaseConfig={
  apiKey:"AIzaSyC4-cGVb2pHwo6LYiD-UoWtmEEZKQxj4_M",
  authDomain:"all-subjects-14322.firebaseapp.com",
  projectId:"all-subjects-14322",
  storageBucket:"all-subjects-14322.firebasestorage.app",
  messagingSenderId:"813955287168",
  appId:"1:813955287168:web:07efa7dde95b117b9bbe65"
};
if(!firebase.apps.length){firebase.initializeApp(firebaseConfig);}
var db=firebase.firestore();

async function loginTeacher(){
  var email=document.getElementById("email_input").value.trim().toLowerCase();
  var pass=document.getElementById("password_input").value.trim();
  var errorBox=document.getElementById("error_box");
  errorBox.innerText="";

  if(!email || !pass){
    errorBox.innerText="أدخل البريد الإلكتروني وكلمة المرور";
    return;
  }

  try{
    var doc=await db.collection("teachers").doc(email).get();
    if(!doc.exists){
      errorBox.innerText="بيانات الدخول غير صحيحة";
      return;
    }
    var data=doc.data()||{};
    if(data.password!==pass){
      errorBox.innerText="بيانات الدخول غير صحيحة";
      return;
    }

    localStorage.setItem("teacherEmail",email);
    localStorage.setItem("teacherName",data.name||"");
    localStorage.setItem("teacherAssignments",JSON.stringify(data.assignments||[]));

    location.href="teacher.html";
  }catch(e){
    console.log(e);
    errorBox.innerText="خطأ أثناء محاولة تسجيل الدخول";
  }
}
</script>

</body>
</html>
